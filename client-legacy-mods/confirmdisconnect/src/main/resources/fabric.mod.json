{
	"schemaVersion": 1,
	"id": "${id}",
	"version": "${version}",
	"name": "${name}",
	"description": "${description}",
	"authors": [
		"Microcontrollers"
	],
	"contributors": [
      "Tellinq"
	],
	"contact": {
		"homepage": "${modrinth}",
		"sources": "${source}",
		"issues": "https://discord.gg/QbNfaCHjUz"
	},
	"license": "${license}",
	"icon": "assets/${id}/icon.png",
