{
  "schemaVersion": 1,
  "id": "blur",
  "version": "${version}",
  "name": "Legacy GUI Blur",
  "description": "Configurable blur, gradients, and fade animations behind Minecraft GUIs",
  "authors": [
    "Motschen",
    "amiralimollaei",
    "tterrag1098",
    "Pyrofab"
  ],
  "contact": {
    "homepage": "https://github.com/Polyfrost/Blur",
    "sources": "https://github.com/Polyfrost/Blur",
    "issues": "https://discord.gg/QbNfaCHjUz"
  },
  "license": "MIT",
  "icon": "assets/blur/icon.png",
  "environment": "client",
  "entrypoints": {
