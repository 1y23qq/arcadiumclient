    ]
  },
  "mixins": [
    "blur.mixins.json"
  ],
  "depends": {
    "minecraft": "1.7.10",
    "fabricloader": ">=0.19.3",
    "oneconfig": ">=1.2.3",
    "osl-entrypoints": ">=0.6.1",
    "osl-lifecycle-events": ">=0.6.1"
  },
  "suggests": {
    "modmenu": ">=0.5.0"
