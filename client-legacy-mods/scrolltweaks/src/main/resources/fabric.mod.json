{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": [
    "Microcontrollers"
  ],
  "contact": {
    "homepage": "${modrinth}",
    "sources": "${source}",
    "issues": "https://discord.gg/QbNfaCHjUz"
  },
  "license": "LGPLv3",
  "icon": "assets/${id}/icon.png",
  "environment": "client",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${mcdep}",
    "java": ">=25",
    "oneconfigv1": "*"
  },
  "breaks": {
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.kofi": "${kofi}",
        "modmenu.discord": "https://discord.gg/QbNfaCHjUz",
        "modmenu.modrinth": "${modrinth}"
      },
      "update_checker": true
    },
    "firmament:hide_from_modlist": true
  }
}
