#version 430
// SPDX-License-Identifier: GPL-3.0-only
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer TickScene { float ticks[]; };
layout(std430,binding=1) readonly buffer FrameScene { float frames[]; };
layout(std430,binding=3) writeonly buffer ResolvedActors { float result[]; };
uniform uint sceneRows;
float angle(float previous,float current,float partial){
    precise float difference=current-previous;
    while(difference< -180.0)difference+=360.0;
    while(difference>=180.0)difference-=360.0;
    precise float step=partial*difference;
    precise float value=previous+step;return value;
}
void main(){
    uint row=gl_GlobalInvocationID.x;if(row>=sceneRows)return;
    uint f=row*27u,t=uint(frames[f+17u])*16u,p=uint(frames[f+18u])*32u;
    precise float partial=frames[f+16u];
    for(uint i=0u;i<16u;i++)result[p+i]=frames[f+i];
    precise float remaining=1.0-partial;
    precise float walkStep=ticks[t+7u]*remaining;
    precise float walk=ticks[t+6u]-walkStep;result[p+16u]=walk;
    precise float speedDifference=ticks[t+7u]-ticks[t+8u];
    precise float speedStep=speedDifference*partial;
    precise float speed=ticks[t+8u]+speedStep;
    result[p+17u]=min(1.0,speed);
    precise float age=ticks[t+9u]+partial;result[p+18u]=age;
    precise float body=angle(ticks[t],ticks[t+1u],partial);
    precise float head=angle(ticks[t+2u],ticks[t+3u],partial);
    precise float yaw=head-body;result[p+19u]=yaw;
    precise float pitchDifference=ticks[t+5u]-ticks[t+4u];
    precise float pitchStep=pitchDifference*partial;
    precise float pitch=ticks[t+4u]+pitchStep;result[p+20u]=pitch;
    result[p+21u]=frames[f+26u];
    uint flags=uint(frames[f+21u]),hands=uint(frames[f+22u]);
    result[p+22u]=(flags&1u)!=0u?1.0:0.0;result[p+23u]=(flags&2u)!=0u?1.0:0.0;
    result[p+24u]=float(hands&255u);result[p+25u]=float(hands>>8u);
    result[p+26u]=(flags&4u)!=0u?1.0:0.0;result[p+27u]=frames[f+20u];result[p+28u]=float(flags>>3u);
    result[p+29u]=-1.0;result[p+30u]=frames[f+24u];result[p+31u]=frames[f+25u];
}
