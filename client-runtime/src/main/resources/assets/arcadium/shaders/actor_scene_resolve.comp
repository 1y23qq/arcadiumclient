#version 430
// SPDX-License-Identifier: GPL-3.0-only
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer TickScene { float ticks[]; };
layout(std430,binding=1) readonly buffer FrameScene { uint frames[]; };
layout(std430,binding=3) writeonly buffer ResolvedActors { uint result[]; };
uniform uint sceneRows;
float frame(uint offset){return uintBitsToFloat(frames[offset]);}
float angle(float previous,float current,float partial){
    precise float difference=current-previous;
    while(difference< -180.0)difference+=360.0;
    while(difference>=180.0)difference-=360.0;
    precise float step=partial*difference;
    precise float value=previous+step;return value;
}
void main(){
    uint row=gl_GlobalInvocationID.x;if(row>=sceneRows)return;
    uint f=row*28u,t=uint(frame(f+17u))*16u,p=uint(frame(f+18u))*32u;
    precise float partial=frame(f+16u);
    for(uint i=0u;i<16u;i++)result[p+i]=frames[f+i];
    precise float remaining=1.0-partial;
    precise float walkStep=ticks[t+7u]*remaining;
    precise float walk=ticks[t+6u]-walkStep;result[p+16u]=floatBitsToUint(walk);
    precise float speedDifference=ticks[t+7u]-ticks[t+8u];
    precise float speedStep=speedDifference*partial;
    precise float speed=ticks[t+8u]+speedStep;
    result[p+17u]=floatBitsToUint(min(1.0,speed));
    precise float age=ticks[t+9u]+partial;result[p+18u]=floatBitsToUint(age);
    precise float body=angle(ticks[t],ticks[t+1u],partial);
    precise float head=angle(ticks[t+2u],ticks[t+3u],partial);
    precise float yaw=head-body;result[p+19u]=floatBitsToUint(yaw);
    precise float pitchDifference=ticks[t+5u]-ticks[t+4u];
    precise float pitchStep=pitchDifference*partial;
    precise float pitch=ticks[t+4u]+pitchStep;result[p+20u]=floatBitsToUint(pitch);
    result[p+21u]=frames[f+26u];
    uint flags=uint(frame(f+21u)),hands=uint(frame(f+22u));
    result[p+22u]=(flags&1u)!=0u?0x3f800000u:0u;result[p+23u]=(flags&2u)!=0u?0x3f800000u:0u;
    result[p+24u]=floatBitsToUint(float(hands&255u));result[p+25u]=floatBitsToUint(float(hands>>8u));
    result[p+26u]=(flags&4u)!=0u?0x3f800000u:0u;result[p+27u]=frames[f+20u];result[p+28u]=floatBitsToUint(float(flags>>3u));
    result[p+29u]=0xbf800000u;result[p+30u]=frames[f+24u];result[p+31u]=frames[f+25u];
    uint descriptor=frames[f+27u],mask=descriptor&31u,payload=descriptor>>5u;
    if(mask!=0u)for(uint word=0u;word<5u;word++)if((mask&(1u<<word))!=0u)result[p+16u+word]=frames[payload++];
}
