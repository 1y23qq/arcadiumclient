bool finiteD(double x) { return !isnan(x) && !isinf(x); }
bool rootFloat(double value,double error,out float result) {
    if(!finiteD(value)||!finiteD(error)||error<0.0LF)return false;
    if(value==0.0LF){result=float(value);return true;}
    float candidate=float(value);
    if(isnan(candidate)||isinf(candidate)||candidate==0.0||abs(candidate)<1.1754943508222875e-38)return false;
    uint bits=floatBitsToUint(candidate);
    float previous=uintBitsToFloat(candidate>0.0?bits-1u:bits+1u);
    float next=uintBitsToFloat(candidate>0.0?bits+1u:bits-1u);
    precise double low=(double(previous)+double(candidate))*0.5LF;
    precise double high=(double(next)+double(candidate))*0.5LF;
    if(!(value-error>low&&value+error<high))return false;
    result=candidate;return true;
}
double rootKernelSin(double x,double y,bool tail) {
    precise double z=x*x;
    precise double w=z*z;
    precise double r=8.33333333332248946124e-3LF+z*(-1.98412698298579493134e-4LF+z*2.75573137070700676789e-6LF)+z*w*(-2.50507602534068634195e-8LF+z*1.58969099521155010221e-10LF);
    precise double v=z*x;
    precise double value=tail?x-((z*(0.5LF*y-v*r)-y)-v*(-1.66666666666666324348e-1LF)):x+v*(-1.66666666666666324348e-1LF+z*r);
    return value;
}
double rootKernelCos(double x,double y) {
    precise double z=x*x;
    precise double w=z*z;
    precise double r=z*(4.16666666666666019037e-2LF+z*(-1.38888888888741095749e-3LF+z*2.48015872894767294178e-5LF))+w*w*(-2.75573143513906633035e-7LF+z*(2.08757232129817482790e-9LF+z*(-1.13596475577881948265e-11LF)));
    precise double hz=0.5LF*z;
    precise double t=1.0LF-hz;
    precise double value=t+(((1.0LF-t)-hz)+(z*r-x*y));
    return value;
}
bool rootSin(float angle,out float result) {
    if(isnan(angle)||isinf(angle)||abs(angle)>6.2831855)return false;
    if(angle==0.0){result=angle;return true;}
    precise double x=double(angle);
    precise double high=x;
    precise double low=0.0LF;
    int n=0;
    if(abs(x)>0.7853981633974483LF) {
        int magnitude=int(floor(abs(x)*6.36619772367581382433e-1LF+0.5LF));
        n=x<0.0LF?-magnitude:magnitude;
        precise double a=double(n)*1.57079632673412561417LF;
        precise double r=x-a;
        precise double w=double(n)*6.07710050650619224932e-11LF;
        high=r-w;low=(r-high)-w;
    }
    int quadrant=n&3;
    precise double value=quadrant==0?rootKernelSin(high,low,n!=0):quadrant==1?rootKernelCos(high,low):quadrant==2?-rootKernelSin(high,low,true):-rootKernelCos(high,low);
    precise double error=abs(value)*1.136868377216160297393798828125e-13LF+6.6174449004242213989712695365597028e-24LF;
    return rootFloat(value,error,result);
}
bool rootCosFromSin(float sine,float angle,out float result) {
    precise float square=sine*sine;
    precise float radicand=1.0-square;
    float cosine=0.0;
    if(radicand!=0.0) {
        precise double y=sqrt(double(radicand));
        precise double residual=fma(-y,y,double(radicand));
        precise double error=abs(residual)/y+abs(y)*2.8421709430404007434844970703125e-14LF+7.8886090522101180541172856528278623e-31LF;
        if(!rootFloat(y,error,cosine))return false;
    }
    precise float a=angle+1.5707964;
    precise float quotient=a/6.2831855;
    precise float turns=float(int(quotient))*6.2831855;
    precise float b=a-turns;
    if(b<0.0)b=6.2831855+b;
    result=b>=3.1415927?-cosine:cosine;return true;
}
void rootTranslate(inout mat4 m,vec3 p) {
    for(int row=0;row<4;row++) {
        precise float pz=m[2][row]*p.z;
        precise float z=pz+m[3][row];
        precise float py=m[1][row]*p.y;
        precise float y=py+z;
        precise float px=m[0][row]*p.x;
        precise float x=px+y;
        m[3][row]=x;
    }
}
void rootScale(inout mat4 m,vec3 s) {
    for(int column=0;column<3;column++)for(int row=0;row<4;row++) {precise float value=m[column][row]*s[column];m[column][row]=value;}
}
mat4 rootRotateZValue(mat4 source,float sine,float cosine) {
    precise vec4 column0;
    precise vec4 column1;
    for(int row=0;row<4;row++) {
        precise float a=source[0][row]*cosine;
        precise float b=source[1][row]*sine;
        precise float c=source[0][row]*-sine;
        precise float d=source[1][row]*cosine;
        precise float x=a+b;
        precise float y=c+d;
        column0[row]=x;column1[row]=y;
    }
    return mat4(column0,column1,source[2],source[3]);
}


double actorDouble(uint at) { return packDouble2x32(uvec2(actorWords[at],actorWords[at+1u])); }
double cameraDouble(uint at) { return packDouble2x32(uvec2(frameWords[at],frameWords[at+1u])); }
uint makeRoot(uint actor,out mat4 root) {
    uint flags=actorWords[actor+19u];
    float height=uintBitsToFloat(actorWords[actor+18u]);
    float partial=uintBitsToFloat(frameWords[6]);
    if(frameWords[10]!=0u)return 6u;
    if(isnan(partial)||isinf(partial)||partial<0.0||partial>1.0||(partial!=0.0&&abs(partial)<1.1754943508222875e-38))return 7u;
    if((flags&~15u)!=0u||isnan(height)||isinf(height)||height<=0.0||height>4.0)return 8u;
    precise dvec3 previous=dvec3(actorDouble(actor+4u),actorDouble(actor+6u),actorDouble(actor+8u));
    precise dvec3 current=dvec3(actorDouble(actor+10u),actorDouble(actor+12u),actorDouble(actor+14u));
    precise dvec3 camera=dvec3(cameraDouble(0u),cameraDouble(2u),cameraDouble(4u));
    for(int i=0;i<3;i++)if(!finiteD(previous[i])||!finiteD(current[i])||!finiteD(camera[i]))return 2u;
    precise dvec3 difference=current-previous;
    precise dvec3 moved=difference*double(partial);
    precise dvec3 world=previous+moved;
    precise dvec3 relative=world-camera;
    if((flags&4u)!=0u)relative.y=relative.y-0.125LF;
    if((flags&8u)!=0u)relative.y=relative.y-0.125LF;
    for(int i=0;i<3;i++)if(!finiteD(relative[i]))return 2u;
    float tx,ty,tz;
    if(!rootFloat(relative.x,0.0LF,tx)||!rootFloat(relative.y,0.0LF,ty)||!rootFloat(relative.z,0.0LF,tz))return 4u;
    float previousYaw=uintBitsToFloat(actorWords[actor+16u]),currentYaw=uintBitsToFloat(actorWords[actor+17u]);
    precise float delta=currentYaw-previousYaw;
    if(isnan(previousYaw)||isinf(previousYaw)||isnan(currentYaw)||isinf(currentYaw)||(previousYaw!=0.0&&abs(previousYaw)<1.1754943508222875e-38)||(currentYaw!=0.0&&abs(currentYaw)<1.1754943508222875e-38)||abs(delta)>1080.0)return 3u;
    for(int i=0;i<4&&delta< -180.0;i++)delta=delta+360.0;
    for(int i=0;i<4&&delta>=180.0;i++)delta=delta-360.0;
    precise float yawStep=partial*delta;
    precise float body=previousYaw+yawStep;
    precise float degrees=180.0-body;
    if(isnan(degrees)||isinf(degrees)||abs(degrees)>360.0)return 3u;
    precise double radians=double(degrees)*0.017453292519943295LF;
    float angle,sine,cosine;
    if(!rootFloat(radians,0.0LF,angle)||!rootSin(angle,sine)||!rootCosFromSin(sine,angle,cosine))return 4u;
    root=mat4(1.0);
    root[0][0]=cosine;root[0][2]=-sine;root[2][0]=sine;root[2][2]=cosine;
    root[3]=vec4(tx,ty,tz,1.0);
    if((flags&1u)!=0u) {
        precise float lift=height+0.1;
        rootTranslate(root,vec3(0.0,lift,0.0));
        float sz,cz;
        if(!rootSin(3.1415927,sz)||!rootCosFromSin(sz,3.1415927,cz))return 4u;
        root=rootRotateZValue(root,sz,cz);
    }
    rootScale(root,vec3(-1.0,-1.0,1.0));
    rootScale(root,vec3(0.9375));
    rootTranslate(root,vec3(0.0,-1.5078125,0.0));
    for(int c=0;c<4;c++)for(int r=0;r<4;r++)if(isnan(root[c][r])||isinf(root[c][r]))return 2u;
    return 0u;
}
void main() {
    uint index=gl_GlobalInvocationID.x;
    if(index==0u&&uint(outputWords.length())>=4u){outputWords[0]=frameWords[8];outputWords[1]=frameWords[9];outputWords[2]=frameWords[7];outputWords[3]=frameWords[11];}
    if(index>=frameWords[7]||index>=2048u||index>=uint(activeSlots.length())||4u+index*32u+31u>=uint(outputWords.length()))return;
    uvec4 identity=activeSlots[index];uint capacity=frameWords[11];
    if(capacity==0u||capacity>2048u||identity.x>=capacity)return;
    uint outAt=4u+identity.x*32u;
    if(outAt+31u>=4u+capacity*32u||outAt+31u>=uint(outputWords.length()))return;
    for(uint i=0u;i<32u;i++)outputWords[outAt+i]=0u;
    uint at=identity.x*20u;uint status=9u;
    mat4 root;
    if(capacity>0u&&capacity<=2048u&&identity.x<capacity&&identity.y>0u&&identity.z>0u&&identity.w==0u&&at+19u<uint(actorWords.length())&&actorWords[at]==identity.y&&actorWords[at+1u]==identity.z&&actorWords[at+2u]==1u)status=makeRoot(at,root);
    outputWords[outAt+12u]=status;outputWords[outAt+13u]=identity.y;outputWords[outAt+14u]=identity.z;outputWords[outAt+15u]=frameWords[8];
    if(status!=0u)return;
    uint packedWord=0u;
    for(uint c=0u;c<4u;c++)for(uint r=0u;r<4u;r++) {
        uint word=floatBitsToUint(root[c][r]);outputWords[outAt+16u+c*4u+r]=word;
        if(r<3u)outputWords[outAt+packedWord++]=word;
    }
}
