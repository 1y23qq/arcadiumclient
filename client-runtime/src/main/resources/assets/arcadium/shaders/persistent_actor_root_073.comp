#version 430 core
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer PersistentActors { uint actorWords[]; };
layout(std430,binding=1) readonly buffer Membership { uvec4 activeSlots[]; };
layout(std430,binding=2) readonly buffer CurrentFrame { uint frameWords[]; };
layout(std430,binding=3) writeonly buffer GeneratedRoots { uint outputWords[]; };

