#version 430
// SPDX-License-Identifier: GPL-3.0-only
layout(local_size_x=64) in;
layout(std430,binding=0) buffer BonePalette { float boneWords[]; };
layout(std430,binding=1) readonly buffer Actors { uint actorWords[]; };
uniform uint actorCount;
void main() {
    uint index=gl_GlobalInvocationID.x,actor=index/12u,part=index%12u;
    if(actor>=actorCount)return;
    uint token=actorWords[actor*19u+16u];
    if(((token>>16u)&(1u<<part))==0u)return;
    mat4 pose=playerPart((token&65535u)*16u+part);
    uint outputOffset=index*12u;
    for(uint column=0u;column<4u;column++)for(uint row=0u;row<3u;row++)
        boneWords[outputOffset+column*3u+row]=pose[column][row];
}
