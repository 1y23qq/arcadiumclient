#version 430
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer Instances { uint words[]; };
layout(std430,binding=1) writeonly buffer Commands { uint commandWords[]; };
uniform uint uInstances;
void main() {
    uint index=gl_GlobalInvocationID.x;
    if(index>=uInstances)return;
    uint source=index*19u,outputWord=index*4u;
    commandWords[outputWord]=words[source+17u];
    commandWords[outputWord+1u]=1u;
    commandWords[outputWord+2u]=words[source+16u];
    commandWords[outputWord+3u]=index;
}
