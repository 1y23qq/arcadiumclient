#version 430
layout(local_size_x=256) in;
struct Mesh { ivec4 origin;uvec4 starts0;uvec4 starts1;uvec4 counts0;uvec4 counts1; };
layout(std430,binding=0) readonly buffer Meshes { Mesh meshes[]; };
layout(std430,binding=1) writeonly buffer Commands { uint words[]; };
layout(std430,binding=2) writeonly buffer Counts { uint draws[]; };
struct NativeOrder { uint count;uint ids[64]; };
layout(std430,binding=3) readonly buffer Orders { NativeOrder nativeOrders[]; };
uniform mat4 uClip;
uniform ivec3 uRenderCamera;
uniform vec3 uCameraFraction;
uniform ivec3 uFaceCamera;
uniform vec3 uFaceCameraFraction;
uniform float uSearchDistance;
uniform uint uDistanceEnabled;
uniform uint uCullFaces;
shared uint prefix[256];
shared uint ranks[256];
shared uint omitted[256];
bool visible(ivec3 origin){
    if(uDistanceEnabled!=0u){
        ivec3 delta=origin-uFaceCamera;
        vec3 closest=vec3(clamp(ivec3(0),delta,delta+ivec3(16)))-uFaceCameraFraction;
        precise float x2=closest.x*closest.x;
        precise float z2=closest.z*closest.z;
        precise float horizontal=x2+z2;
        precise float maximum=uSearchDistance*uSearchDistance;
        if(horizontal>=maximum||abs(closest.y)>=uSearchDistance)return false;
    }
    ivec3 delta=origin-uRenderCamera;
    if(any(greaterThan(abs(delta),ivec3(1048576))))return true;
    vec3 center=vec3(delta)-uCameraFraction+vec3(8.0);
    vec4 clip=uClip*vec4(center,1.0);
    vec4 radius=(abs(uClip[0])+abs(uClip[1])+abs(uClip[2]))*9.25;
    for(int axis=0;axis<3;axis++){
        float margin=radius[axis]+radius.w+.01;
        if(clip.w+clip[axis]<-margin||clip.w-clip[axis]<-margin)return false;
    }
    return true;
}
uint visibleFaces(ivec3 origin){
    bvec3 positive=greaterThan(uFaceCamera,origin-ivec3(3)),negative=lessThan(uFaceCamera,origin+ivec3(19));
    return 64u|uint(positive.x)|uint(positive.y)<<1u|uint(positive.z)<<2u|uint(negative.x)<<3u|uint(negative.y)<<4u|uint(negative.z)<<5u;
}
void main(){
    uint lane=gl_LocalInvocationID.x,region=gl_WorkGroupID.x,commands=0u;
    ranks[lane]=0xffffffffu;barrier();
    uint listed=nativeOrders[region].count;
    if(lane<listed){uint word=nativeOrders[region].ids[lane>>2u],section=(word>>((lane&3u)*8u))&255u;ranks[section]=lane;}
    barrier();
    omitted[lane]=ranks[lane]==0xffffffffu?1u:0u;barrier();
    for(uint distance=1u;distance<256u;distance<<=1u){uint before=lane>=distance?omitted[lane-distance]:0u;barrier();omitted[lane]+=before;barrier();}
    uint rank=ranks[lane]==0xffffffffu?listed+omitted[lane]-1u:ranks[lane];
    Mesh mesh=meshes[region*256u+lane];uint bases[7],counts[7];
    if(visible(mesh.origin.xyz)){
        uint mask=uCullFaces==0u?127u:visibleFaces(mesh.origin.xyz),previousEnd=0xffffffffu;
        for(uint face=0u;face<7u;face++){
            uint elements=face<4u?mesh.counts0[face]:mesh.counts1[face-4u];if(elements==0u||(mask&(1u<<face))==0u)continue;
            uint base=face<4u?mesh.starts0[face]:mesh.starts1[face-4u];
            if(commands>0u&&previousEnd==base)counts[commands-1u]+=elements;else{bases[commands]=base;counts[commands]=elements;commands++;}
            previousEnd=base+elements/6u*4u;
        }
    }
    prefix[rank]=commands;barrier();
    for(uint distance=1u;distance<256u;distance<<=1u){uint before=lane>=distance?prefix[lane-distance]:0u;barrier();prefix[lane]+=before;barrier();}
    uint first=prefix[rank]-commands;
    for(uint index=0u;index<commands;index++){
        uint offset=(region*1792u+first+index)*5u;
        words[offset]=counts[index];words[offset+1u]=1u;words[offset+2u]=0u;words[offset+3u]=bases[index];words[offset+4u]=0u;
    }
    if(lane==255u)draws[region]=prefix[255];
}
