{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "Arcadium Core",
  "description": "Arcadium configuration and HUD library, adapted from OneConfig.",
  "authors": [
    "Polyfrost",
    "0aurorq3 (Arcadium modifications)"
  ],
  "contact": {
    "homepage": "https://arcadiumclient.com",
    "sources": "https://github.com/1y23qq/arcadiumclient",
    "issues": "https://discord.gg/QbNfaCHjUz"
  },
  "icon": "oneconfig-icon.png",
  "provides": [
    "oneconfigbootstrap"
  ],
  "license": "GPL-3.0-only",
  "environment": "client",
  "depends": {
    "fabricloader": ">=0.12.0",
    "minecraft": "${mc_version}",
    "oneconfigv1": "${mod_version}",
    "compose-multiplatform": ">=1.0.5",
    "fabric-language-kotlin": ">=1.13.13+kotlin.2.4.10"
  },
  "breaks": {
    "polyplus": "<1.2.49"
  },
  "custom": {
    "arcadium:upstream": {
      "name": "OneConfig",
      "authors": "Polyfrost and contributors",
      "sources": "https://github.com/Polyfrost/OneConfig",
      "license": "LICENSE"
    }
  }
}
